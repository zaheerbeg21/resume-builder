# ==============================================================================
# ATS Resume Builder - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# SECURITY NOTICE:
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser/client.
# - All other variables are SERVER-ONLY and must NEVER be exposed to the client.
# - Never commit real production keys or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# [CLIENT-SAFE] URL endpoint for Supabase client & REST/Auth API.
# Local default points to Supabase CLI local instance (port 54321).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# [CLIENT-SAFE] Public anonymous API key for client-side queries, protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key

# [SERVER-ONLY] Privileged administrative key that bypasses Row Level Security (RLS).
# Used exclusively for server-side operations (e.g. webhooks, seed scripts). NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY=dummy_service_role_key_never_expose_to_client

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration
# ------------------------------------------------------------------------------
# [SERVER-ONLY] Google Gemini API Key for LLM extraction and structured parsing.
GEMINI_API_KEY=dummy_gemini_api_key_server_only

# [SERVER-ONLY] Fast model identifier for low-latency tasks (e.g., keyword extraction).
GEMINI_MODEL_FAST=gemini-2.0-flash

# [SERVER-ONLY] Quality model identifier for high-reasoning tasks (e.g., bullet evaluation).
GEMINI_MODEL_QUALITY=gemini-1.5-pro

# ------------------------------------------------------------------------------
# Stripe Payments Configuration
# ------------------------------------------------------------------------------
# [SERVER-ONLY] Secret API key for Stripe Checkout session creation.
STRIPE_SECRET_KEY=sk_test_dummy_stripe_secret_key

# [SERVER-ONLY] Webhook signing secret (whsec_...) used to verify Stripe webhook signatures.
STRIPE_WEBHOOK_SECRET=whsec_dummy_stripe_webhook_secret

# ------------------------------------------------------------------------------
# Application Base URL
# ------------------------------------------------------------------------------
# [CLIENT-SAFE] Canonical base URL of the frontend application (used in auth redirects & metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000
